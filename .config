
#
# Agent 功能配置
#
CONFIG_AGENT_EXTENSIONS_ENABLED=y
CONFIG_INTENT_GATE_ENABLED=y
CONFIG_PLAN_REVIEW_ENABLED=y
CONFIG_TEAM_MODE_ENABLED=y
CONFIG_RALPH_LOOP_ENABLED=y
CONFIG_MODEL_FALLBACK_ENABLED=y
CONFIG_TODO_ENFORCER_ENABLED=y
CONFIG_RULES_INJECTION_ENABLED=y
CONFIG_PROMETHEUS_INTERVIEW_ENABLED=y
CONFIG_SKILL_SCOPED_TOOLS_ENABLED=y
CONFIG_COMPACTION_RECOVERY_ENABLED=y
CONFIG_SESSION_RECOVERY_ENABLED=y
# end of Agent 功能配置

CONFIG_ARCH_HOST=y
# CONFIG_ARCH_MIPS is not set
# CONFIG_ARCH_ARM is not set

#
# 驱动
#
CONFIG_ENABLE_VISION=y
CONFIG_ENABLE_FEISHU=y
CONFIG_ENABLE_VECTOR=y
CONFIG_ENABLE_GATEWAY=y
CONFIG_ENABLE_CRON=y
CONFIG_WORKQUEUE=y
CONFIG_TIMER=y
CONFIG_ENABLE_SKILLS=y
CONFIG_ENABLE_MEMORY=y
# end of 驱动
