
#
# Daima Agent 功能配置
#
CONFIG_AGENT_EXTENSIONS_ENABLED=y
CONFIG_DAIMA_INTENT_GATE_ENABLED=y
CONFIG_DAIMA_PLAN_REVIEW_ENABLED=y
CONFIG_DAIMA_TEAM_MODE_ENABLED=y
CONFIG_DAIMA_RALPH_LOOP_ENABLED=y
CONFIG_DAIMA_MODEL_FALLBACK_ENABLED=y
CONFIG_DAIMA_TODO_ENFORCER_ENABLED=y
CONFIG_DAIMA_RULES_INJECTION_ENABLED=y
CONFIG_DAIMA_PROMETHEUS_INTERVIEW_ENABLED=y
CONFIG_DAIMA_SKILL_SCOPED_TOOLS_ENABLED=y
CONFIG_DAIMA_COMPACTION_RECOVERY_ENABLED=y
CONFIG_DAIMA_SESSION_RECOVERY_ENABLED=y
# end of Daima Agent 功能配置

#
# 驱动
#
CONFIG_DAIMA_ENABLE_VISION=y
CONFIG_DAIMA_ENABLE_FEISHU=y
CONFIG_DAIMA_ENABLE_VECTOR=y
CONFIG_DAIMA_ENABLE_GATEWAY=y
CONFIG_DAIMA_ENABLE_CRON=y
CONFIG_DAIMA_ENABLE_SKILLS=y
CONFIG_DAIMA_ENABLE_MEMORY=y
# end of 驱动
