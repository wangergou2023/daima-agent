# scripts/Makefile.build - 实际编译规则

include $(TOPDIR)/scripts/Kbuild.include

.DEFAULT_GOAL := __build

src := $(obj)
kbuild-dir := $(if $(filter /%,$(src)),$(src),$(srctree)/$(src))
obj-out := $(BUILD_DIR)/$(obj)

include $(kbuild-dir)/Makefile

__subdir-y := $(patsubst %/,%,$(filter %/, $(obj-y)))
obj-y := $(filter-out %/, $(obj-y))

obj-files := $(addprefix $(obj-out)/, $(obj-y))
dep-files := $(obj-files:.o=.d)

# 编译当前目录的 .c → build-kbuild/<dir>/*.o
$(obj-out)/%.o: $(src)/%.c
	@mkdir -p $(dir $@)
	@echo "  CC      $(patsubst $(BUILD_DIR)/%,%,$@)"
	$(Q)$(CC) $(AGENT_CFLAGS) -MMD -MP -MF $(@:.o=.d) -c -o $@ $<

# 子目录递归
subdirs: $(patsubst %, _subdir_%, $(__subdir-y))
.PHONY: __build subdirs built-in.o $(patsubst %, _subdir_%, $(__subdir-y))
_subdir_%:
	$(Q)$(MAKE) -f $(TOPDIR)/scripts/Makefile.build obj=$(obj)/$*

# 收集所有 .o 文件
ifeq ($(KBUILD_DOC_ONLY),1)
__build built-in.o: subdirs
	@:
else
__build: built-in.o
	@:

built-in.o: $(obj-files) subdirs
	@mkdir -p $(BUILD_DIR)
	@printf '%s\n' $(obj-files) >> $(BUILD_DIR)/objects.list
endif

-include $(dep-files)
