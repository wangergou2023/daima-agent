# Minimal Kbuild shorthands — 仅保留 Makefile.build 和 Makefile.clean 需要的宏
#
# 原 272 行 Linux kernel Kbuild.include 克隆 → 精简为 5 行
# 删除的未使用功能: fixdep, if_changed, if_changed_dep, savedcmd, filechk,
#   read-file, test-ge/gt/lt/le, kecho, delete-on-interrupt, why(V=2)

# Shorthand for $(Q)$(MAKE) -f scripts/Makefile.build obj=
# Usage: $(Q)$(MAKE) $(build)=dir
build := -f $(srctree)/scripts/Makefile.build obj

# Shorthand for $(Q)$(MAKE) -f scripts/Makefile.clean obj=
# Usage: $(Q)$(MAKE) $(clean)=dir
clean := -f $(srctree)/scripts/Makefile.clean obj
