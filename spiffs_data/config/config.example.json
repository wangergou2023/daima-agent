{
    "common": {
        "timezone": "UTC",
        "terminal_security_level": "plan",
        "context_limit_tokens": 0,
        "session_max_msgs": 96,
        "compress_trigger_msgs": 12,
        "compress_keep_msgs": 6,
        "web_port": 1234,
        "cron_check_interval_ms": 60000,
        "heartbeat_interval_ms": 1800000
    },
    "web": {
        "default_pet_package_id": "kitty.codex-pet"
    },
    "vector": {
        "enabled": false
    },
    "category_routing": {
        "categories": {
            "deep":  "your_deep_provider",
            "quick": "your_quick_provider"
        },
        "role_model_map": {
            "FAST": "quick",
            "ORACLE": "deep",
            "IMPLEMENT": "deep"
        }
    },
    "active_provider": "your_provider_name",
    "providers": {
        "your_provider_name": {
            "api_key": "sk-xxxxxxxxxxxxxxxxxxxxx",
            "openai_base_url": "https://api.openai.com/v1",
            "model": "gpt-4o-mini",
            "context_limit_tokens": 128000,
            "thinking_mode": "omit",
            "needs_reasoning_content": true,
            "max_output_tokens": 16384,
            "request_timeout_ms": 300000
        }
    },
    "feishu": {
        "app_id": "",
        "app_secret": "",
        "default_chat_id": ""
    },
    "audio": {
        "bigmodel_api_key": "",
        "ao_vol": 60,
        "ao_gain": 20,
        "ai_vol": 60,
        "ai_gain": 23,
        "voice_record_ms": 3000
    },
    "mips": {
        "wake_gpio_num": 64,
        "wake_gpio_active_low": 1,
        "wake_gpio_poll_ms": 20,
        "wake_gpio_debounce_ms": 200
    }
}
