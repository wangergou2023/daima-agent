# Simple kbuild-style compile rules for Daima objects.

CC      ?= cc
AR      ?= ar
AGENT_ROOT ?= $(CURDIR)
BUILD   ?= $(CURDIR)/build

CFLAGS  ?= -std=c11 -Wall -Wextra -O2
CPPFLAGS += -I$(AGENT_ROOT) \
            -I$(AGENT_ROOT)/include \
            -I$(AGENT_ROOT)/init \
            -I$(AGENT_ROOT)/kernel \
            -I$(AGENT_ROOT)/kernel/time \
            -I$(AGENT_ROOT)/ipc \
            -I$(AGENT_ROOT)/lib \
            -I$(AGENT_ROOT)/net \
            -I$(AGENT_ROOT)/fs

src-y ?=
obj-y := $(patsubst $(AGENT_ROOT)/%.c,$(BUILD)/%.o,$(src-y))

.PHONY: all clean

all: $(BUILD)/built-in.a

$(BUILD)/built-in.a: $(obj-y)
	$(AR) rcs $@ $^

$(BUILD)/%.o: $(AGENT_ROOT)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD)
