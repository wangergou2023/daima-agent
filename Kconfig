# agent Kconfig (内核风格: source 子Kconfig)
mainmenu "Agent Configuration"

source "arch/Kconfig"

menu "Agent Extensions"
config AGENT_EXTENSIONS_ENABLED
    bool "Agent扩展系统"
    default y

config INTENT_GATE_ENABLED
    bool "意图LLM分类"
    default y
    help
      每条用户消息调用 LLM 判定意图（IMPLEMENT/FIX/QA/INVESTIGATE/OPEN）。
      关闭时所有消息按 OPEN 处理。

config PLAN_REVIEW_ENABLED
    bool "计划评审"
    default y

config TEAM_MODE_ENABLED
    bool "Team Mode"
    default y

config RALPH_LOOP_ENABLED
    bool "Ralph Loop"
    default y

config MODEL_FALLBACK_ENABLED
    bool "模型回退"
    default y

config TODO_ENFORCER_ENABLED
    bool "待办强制执行"
    default y

config RULES_INJECTION_ENABLED
    bool "规则注入"
    default y

config PROMETHEUS_INTERVIEW_ENABLED
    bool "Prometheus访谈模式"
    default y

config SKILL_SCOPED_TOOLS_ENABLED
    bool "Skill内嵌工具"
    default y

config COMPACTION_RECOVERY_ENABLED
    bool "压缩恢复"
    default y

config SESSION_RECOVERY_ENABLED
    bool "会话恢复"
    default y
endmenu

source "kernel/Kconfig"
source "drivers/llm/Kconfig"
source "drivers/channel/Kconfig"

menu "Other Drivers"
config ENABLE_VISION
    bool "图像理解"
    default y

config ENABLE_SKILLS
    bool "Skill系统"
    default y

config ENABLE_MEMORY
    bool "会话记忆"
    default y
endmenu
