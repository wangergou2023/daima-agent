#!/bin/sh
set -eu

APP_DIR="/usr/lib/agent"
AGENT_SEED_DIR="${AGENT_SEED_DIR:-/usr/share/agent/spiffs_data}"
AGENT_HOME="${AGENT_HOME:-$HOME/.agent-data}"

copy_tree_missing() {
    src="$1"
    dst="$2"
    [ -d "$src" ] || return 0
    (cd "$src" && find . -type d -exec mkdir -p "$dst/{}" \; -o -type f -exec sh -c '
        src_root="$1"
        dst_root="$2"
        rel="$3"
        target="$dst_root/$rel"
        [ -e "$target" ] || install -Dm644 "$src_root/$rel" "$target"
    ' sh "$src" "$dst" {} \;)
}

copy_file_missing() {
    src="$1"
    dst="$2"
    [ -e "$src" ] || return 0
    [ -e "$dst" ] || install -Dm644 "$src" "$dst"
}

mkdir -p "$AGENT_HOME/bin" \
         "$AGENT_HOME/spiffs_data/config" \
         "$AGENT_HOME/spiffs_data/web" \
         "$AGENT_HOME/spiffs_data/skills" \
         "$AGENT_HOME/spiffs_data/ca" \
         "$AGENT_HOME/spiffs_data/memory" \
         "$AGENT_HOME/spiffs_data/sessions" \
         "$AGENT_HOME/spiffs_data/cache"

copy_tree_missing "$AGENT_SEED_DIR/web" "$AGENT_HOME/spiffs_data/web"
copy_tree_missing "$AGENT_SEED_DIR/skills" "$AGENT_HOME/spiffs_data/skills"
rm -rf "$AGENT_HOME/spiffs_data/skills/robot-control" \
       "$AGENT_HOME/spiffs_data/skills/feishu-card-writer" \
       "$AGENT_HOME/spiffs_data/skills/pet-director"

copy_file_missing "$AGENT_SEED_DIR/ca/cacert.pem" "$AGENT_HOME/spiffs_data/ca/cacert.pem"
copy_file_missing "$AGENT_SEED_DIR/config/config.example.json" "$AGENT_HOME/spiffs_data/config/config.example.json"

for pet_dir in "$AGENT_SEED_DIR"/*.codex-pet; do
    [ -d "$pet_dir" ] || continue
    copy_tree_missing "$pet_dir" "$AGENT_HOME/spiffs_data/$(basename "$pet_dir")"
done

created_config=0
if [ ! -e "$AGENT_HOME/spiffs_data/config/config.json" ]; then
    if [ -e "$AGENT_SEED_DIR/config/config.json" ]; then
        install -m644 "$AGENT_SEED_DIR/config/config.json" "$AGENT_HOME/spiffs_data/config/config.json"
    else
        install -m644 "$AGENT_SEED_DIR/config/config.example.json" "$AGENT_HOME/spiffs_data/config/config.json"
    fi
    created_config=1
fi

if [ "$created_config" -eq 1 ]; then
    python3 - "$AGENT_HOME/spiffs_data/config/config.json" <<'PY'
import json
import sys

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as f:
    data = json.load(f)
for provider in data.get("providers", {}).values():
    if isinstance(provider, dict) and provider.get("api_key", "").startswith("<your-"):
        provider["api_key"] = ""
feishu = data.get("feishu")
if isinstance(feishu, dict):
    for key in ("app_id", "app_secret"):
        if feishu.get(key, "").startswith("<your-"):
            feishu[key] = ""
audio = data.get("audio")
if isinstance(audio, dict) and audio.get("bigmodel_api_key", "").startswith("<your-"):
    audio["bigmodel_api_key"] = ""
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)
    f.write("\n")
PY
fi

for name in BOOTSTRAP.md IDENTITY.md SOUL.md USER.md; do
    copy_file_missing "$AGENT_SEED_DIR/config/$name" "$AGENT_HOME/spiffs_data/config/$name"
done
